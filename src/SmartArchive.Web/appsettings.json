{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SmartArchiveDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "StagingContainer": "staging",
    "ArchiveContainer": "archive"
  },
  "AzureDocumentIntelligence": {
    "Endpoint": "https://YOUR-RESOURCE-NAME.cognitiveservices.azure.com/",
    "ApiKey": "YOUR-AZURE-DOCUMENT-INTELLIGENCE-KEY",
    "MinimumConfidenceThreshold": 0.80
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
