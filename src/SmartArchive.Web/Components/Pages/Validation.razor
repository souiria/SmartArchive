@page "/validation"
@page "/validation/{DocumentId:guid}"
@attribute [Authorize(Roles = "Administrator,DepartmentManager")]
@using Microsoft.EntityFrameworkCore
@using SmartArchive.Application.Common.Interfaces
@inject IApplicationDbContext DbContext
@inject DocumentWorkflowService WorkflowService
@inject IBlobStorageService BlobStorage
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">AI Classification Validation</MudText>

@if (_document is null)
{
    <MudAlert Severity="Severity.Info">No documents currently awaiting validation, or select one from the Dashboard.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-2" Elevation="3" Style="height: 750px;">
                @if (!string.IsNullOrEmpty(_pdfPreviewUrl))
                {
                    <iframe src="@_pdfPreviewUrl" width="100%" height="100%" style="border:none;"></iframe>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-6" Elevation="3">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    Extracted Metadata (@_document.DocumentNumber)
                    @if (_document.AIProcessingResult is not null)
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">
                            Confidence: @_document.AIProcessingResult.OverallConfidence.ToString("P0")
                        </MudChip>
                    }
                </MudText>

                <MudSelect T="Guid" Label="Target Department" @bind-Value="_command.DepartmentId" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var dept in _departments)
                    {
                        <MudSelectItem Value="@dept.Id">@dept.NameFr / @dept.NameAr</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Guid" Label="Document Type" @bind-Value="_command.DocumentTypeId" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var dt in _docTypes)
                    {
                        <MudSelectItem Value="@dt.Id">@dt.NameFr / @dt.NameAr</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField Label="Title" @bind-Value="_command.Title" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField Label="Reference Number" @bind-Value="_command.ReferenceNumber" Variant="Variant.Outlined" Class="mb-3" />
                <MudDatePicker Label="Document Date" Date="@(_command.DocumentDate?.ToDateTime(TimeOnly.MinValue))"
                               DateChanged="@(d => _command.DocumentDate = d.HasValue ? DateOnly.FromDateTime(d.Value) : null)"
                               Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField Label="Sender / Supplier" @bind-Value="_command.SenderName" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField Label="Employee / Customer Name" @bind-Value="_command.RelatedPersonName" Variant="Variant.Outlined" Class="mb-3" />
                <MudNumericField T="decimal?" Label="Total Amount" @bind-Value="_command.TotalAmount" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField Label="Keywords" @bind-Value="_command.Keywords" Variant="Variant.Outlined" Class="mb-4" />

                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Size="Size.Large" OnClick="ConfirmArchive">
                    Validate & Archive Document
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid? DocumentId { get; set; }
    private Document? _document;
    private string? _pdfPreviewUrl;
    private List<Department> _departments = new();
    private List<DocumentType> _docTypes = new();
    private ValidateDocumentCommand _command = new();

    protected override async Task OnParametersSetAsync()
    {
        _departments = await DbContext.Departments.AsNoTracking().ToListAsync();
        _docTypes = await DbContext.DocumentTypes.AsNoTracking().ToListAsync();

        var query = DbContext.Documents
            .Include(d => d.AIProcessingResult)
            .Include(d => d.MetadataItems)
            .AsQueryable();

        _document = DocumentId.HasValue
            ? await query.FirstOrDefaultAsync(d => d.Id == DocumentId.Value)
            : await query.OrderBy(d => d.CreatedAt).FirstOrDefaultAsync(d => d.Status == DocumentStatus.AwaitingValidation);

        if (_document is not null)
        {
            var sas = await BlobStorage.GenerateReadSasUriAsync(_document.BlobContainer, _document.BlobPath, TimeSpan.FromHours(1));
            _pdfPreviewUrl = sas.ToString();

            _command = new ValidateDocumentCommand
            {
                DocumentId = _document.Id,
                DepartmentId = _document.DepartmentId ?? _document.SuggestedDepartmentId ?? _departments.First().Id,
                DocumentTypeId = _document.DocumentTypeId ?? _docTypes.First().Id,
                Title = _document.Title,
                ReferenceNumber = _document.ReferenceNumber,
                DocumentDate = _document.DocumentDate,
                SenderName = _document.SenderName,
                RecipientName = _document.RecipientName,
                RelatedPersonName = _document.RelatedPersonName,
                TotalAmount = _document.TotalAmount,
                Currency = _document.Currency,
                Keywords = _document.Keywords,
                Metadata = _document.MetadataItems.ToDictionary(m => m.Key, m => m.Value)
            };
        }
    }

    private async Task ConfirmArchive()
    {
        await WorkflowService.ValidateAndArchiveAsync(_command);
        Snackbar.Add("Document validated and archived permanently!", Severity.Success);
        Navigation.NavigateTo("/search");
    }
}
