@page "/validation"
@rendermode InteractiveServer
@using SmartArchive.Application
@using SmartArchive.Domain
@inject IDocumentRepository Repository
@inject IDocumentWorkflow Workflow
<PageTitle>Centre de validation · Smart Archive</PageTitle>
<div class="page-heading"><div><div class="eyebrow">CONTRÔLE HUMAIN OBLIGATOIRE</div><h1>Centre de validation</h1><p>Vérifiez le document source et corrigez les suggestions avant approbation.</p></div></div>
@if (_docs.Count==0) { <div class="panel empty-state"><span>✓</span><h2>La file de validation est vide</h2><p>Les nouveaux dépôts apparaîtront ici après leur analyse.</p><a class="button primary" href="/depot">Déposer un document</a></div> } else { <div class="validation-list">@foreach(var d in _docs) { <article class="validation-card"><div class="validation-preview"><div class="preview-toolbar"><span class="file-mark">PDF</span><span>@d.FileName</span><a target="_blank" href="/api/documents/@d.Id/file">Ouvrir dans un nouvel onglet ↗</a></div><iframe title="Aperçu PDF : @d.FileName" src="/api/documents/@d.Id/file"></iframe></div><div class="validation-form"><div class="review-alert">IA — suggestion indicative <strong>@d.Confidence.ToString("P0")</strong><small>Ce score n’est pas une garantie de justesse.</small></div>@if(!string.IsNullOrWhiteSpace(d.Warnings)){<div class="alert alert-warn">@d.Warnings</div>}<label>Titre<input @bind="d.Title" /></label><label>Département<select @bind="d.DepartmentName">@foreach(var dep in _departments){<option>@dep.Name</option>}</select></label><label>Catégorie<input @bind="d.Category" /></label><label>Date du document<input type="date" @bind="d.DocumentDate" /></label><label>Référence<input @bind="d.ReferenceNumber" /></label><label>Commentaire de validation<textarea @bind="d.ReviewerComment" rows="2"></textarea></label>@if(!string.IsNullOrEmpty(d.ExtractedText)){<details><summary>Texte extrait</summary><p class="extracted">@d.ExtractedText</p></details>}<div class="review-actions"><button class="button primary" @onclick="()=>Review(d,true)">Approuver et archiver</button><button class="button danger" @onclick="()=>Review(d,false)">Rejeter</button></div></div></article> }</div> }
@if(!string.IsNullOrEmpty(_message)){<div class="toast">@_message</div>}
@code { private List<ArchiveDocument> _docs=[]; private List<Department> _departments=[]; private string _message=""; protected override async Task OnInitializedAsync(){_departments=(await Repository.DepartmentsAsync()).ToList(); _docs=(await Repository.ListAsync(status:DocumentStatus.PendingValidation)).ToList();} private async Task Review(ArchiveDocument d,bool approve){await Workflow.ReviewAsync(d.Id,d.Title,d.DepartmentName,d.Category,d.DocumentDate,d.ReferenceNumber,d.ReviewerComment??"","Validateur local",approve); _docs.Remove(d); _message=approve?"Document approuvé et archivé.":"Document rejeté.";} }
