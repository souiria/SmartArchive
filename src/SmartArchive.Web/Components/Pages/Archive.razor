@page "/archive"
@rendermode InteractiveServer
@using System.Globalization
@using SmartArchive.Application
@using SmartArchive.Domain
@inject IDocumentRepository Repository

<PageTitle>Document archive · Smart Archive</PageTitle>

<MudStack Class="sa-page-header">
    <MudText Typo="Typo.overline" Class="sa-eyebrow">DOCUMENT SEARCH</MudText>
    <MudText Typo="Typo.h4" Class="sa-page-title">Archive</MudText>
    <MudText Class="sa-page-subtitle">Search approved and archived documents.</MudText>
</MudStack>

<MudPaper Outlined="true" Class="sa-surface">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-4 sa-search-row" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_query" @bind-Value:after="Search" Placeholder="Title, reference, department, keywords…" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Class="sa-search-field" />
        <MudSelect T="string" @bind-Value="_department" Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="sa-department-filter">
            <MudSelectItem T="string" Value="@string.Empty">All departments</MudSelectItem>
            @foreach (var department in _departments) { <MudSelectItem T="string" Value="@department.Id.ToString()">@department.Name</MudSelectItem> }
        </MudSelect>
        <MudButton OnClick="Search" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList">Filter</MudButton>
    </MudStack>
    <MudTable Items="_docs" Hover="true" Dense="true" Elevation="0" Class="sa-table">
        <HeaderContent><MudTh>Title / Reference</MudTh><MudTh>Department</MudTh><MudTh>Category</MudTh><MudTh>Document date</MudTh><MudTh>Reviewed by</MudTh><MudTh>File</MudTh></HeaderContent>
        <RowTemplate Context="doc"><MudTd DataLabel="Title"><div class="sa-document-title">@doc.Title</div><div class="sa-file-name">@doc.ReferenceNumber · @doc.FileName</div></MudTd><MudTd DataLabel="Department">@doc.DepartmentName</MudTd><MudTd DataLabel="Category">@doc.Category</MudTd><MudTd DataLabel="Date">@doc.DocumentDate?.ToString("MM/dd/yyyy", CultureInfo.GetCultureInfo("en-US"))</MudTd><MudTd DataLabel="Reviewed by">@doc.ValidatedBy</MudTd><MudTd DataLabel="File"><MudIconButton Href="@($"/api/documents/{doc.Id}/file")" Target="_blank" Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" Size="Size.Small" aria-label="Open PDF" /></MudTd></RowTemplate>
        <NoRecordsContent><MudText Class="pa-8 sa-empty-state">No archived documents match your search.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private string _query = string.Empty;
    private string _department = string.Empty;
    private List<ArchiveDocument> _docs = [];
    private List<Department> _departments = [];

    protected override async Task OnInitializedAsync()
    {
        _departments = (await Repository.DepartmentsAsync()).ToList();
        await Search();
    }

    private async Task Search()
    {
        int? departmentId = int.TryParse(_department, out var id) ? id : null;
        _docs = (await Repository.ListAsync(_query, DocumentStatus.Archived, departmentId)).ToList();
    }
}
