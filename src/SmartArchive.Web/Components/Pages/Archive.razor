@page "/archive"
@rendermode InteractiveServer
@using SmartArchive.Application
@using SmartArchive.Domain
@inject IDocumentRepository Repository
<PageTitle>Archive documentaire · Smart Archive</PageTitle>
<MudStack Class="sa-page-header"><MudText Typo="Typo.overline" Class="sa-eyebrow">CONSULTATION DOCUMENTAIRE</MudText><MudText Typo="Typo.h4" Class="sa-page-title">Archive</MudText><MudText Class="sa-page-subtitle">Recherchez dans les documents approuvés et archivés.</MudText></MudStack>
<MudPaper Outlined="true" Class="sa-surface">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-4 sa-search-row" Wrap="Wrap.Wrap"><MudTextField @bind-Value="_query" @bind-Value:after="Search" Placeholder="Titre, référence, département, mots-clés…" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Class="sa-search-field" /><MudSelect T="string" @bind-Value="_department" Label="Département" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="sa-department-filter"><MudSelectItem T="string" Value="@string.Empty">Tous les départements</MudSelectItem>@foreach(var d in _departments){<MudSelectItem T="string" Value="@d.Id.ToString()">@d.Name</MudSelectItem>}</MudSelect><MudButton OnClick="Search" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterList">Filtrer</MudButton></MudStack>
    <MudTable Items="_docs" Hover="true" Dense="true" Elevation="0" Class="sa-table">
        <HeaderContent><MudTh>Titre / Référence</MudTh><MudTh>Département</MudTh><MudTh>Catégorie</MudTh><MudTh>Date document</MudTh><MudTh>Validé par</MudTh><MudTh>Fichier</MudTh></HeaderContent>
        <RowTemplate Context="doc"><MudTd DataLabel="Titre"><div class="sa-document-title">@doc.Title</div><div class="sa-file-name">@doc.ReferenceNumber · @doc.FileName</div></MudTd><MudTd DataLabel="Département">@doc.DepartmentName</MudTd><MudTd DataLabel="Catégorie">@doc.Category</MudTd><MudTd DataLabel="Date">@doc.DocumentDate?.ToString("dd/MM/yyyy")</MudTd><MudTd DataLabel="Validé par">@doc.ValidatedBy</MudTd><MudTd DataLabel="Fichier"><MudIconButton Href="@($"/api/documents/{doc.Id}/file")" Target="_blank" Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" Size="Size.Small" /></MudTd></RowTemplate>
        <NoRecordsContent><MudText Class="pa-8 sa-empty-state">Aucun document archivé ne correspond à votre recherche.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>
@code {private string _query=""; private string _department=""; private List<ArchiveDocument> _docs=[]; private List<Department> _departments=[]; protected override async Task OnInitializedAsync(){_departments=(await Repository.DepartmentsAsync()).ToList(); await Search();} private async Task Search(){int? dep=int.TryParse(_department,out var id)?id:null; _docs=(await Repository.ListAsync(_query,DocumentStatus.Archived,dep)).ToList();}}
