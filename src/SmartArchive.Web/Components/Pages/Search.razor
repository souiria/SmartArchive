@page "/search"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using SmartArchive.Application.Common.Interfaces
@using SmartArchive.Application.Common.Models
@inject IApplicationDbContext DbContext
@inject DocumentWorkflowService WorkflowService

<MudText Typo="Typo.h4" GutterBottom="true">Enterprise Archive & Search</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_request.Query" Label="Full-Text / Keywords / Archive ID" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="Guid?" Label="Department" @bind-Value="_request.DepartmentId" Clearable="true" Variant="Variant.Outlined">
                @foreach (var dept in _departments)
                {
                    <MudSelectItem T="Guid?" Value="@dept.Id">@dept.NameFr</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="Guid?" Label="Document Type" @bind-Value="_request.DocumentTypeId" Clearable="true" Variant="Variant.Outlined">
                @foreach (var dt in _docTypes)
                {
                    <MudSelectItem T="Guid?" Value="@dt.Id">@dt.NameFr</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="ExecuteSearch">Search</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_results is not null)
{
    <MudTable Items="@_results.Items" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Archive ID</MudTh>
            <MudTh>Title</MudTh>
            <MudTh>Reference</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Department</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Amount</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.DocumentNumber</MudTd>
            <MudTd>@context.Title</MudTd>
            <MudTd>@context.ReferenceNumber</MudTd>
            <MudTd>@context.DocumentDate?.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@context.DepartmentNameFr</MudTd>
            <MudTd>@context.DocumentTypeNameFr</MudTd>
            <MudTd>@(context.TotalAmount.HasValue ? $"{context.TotalAmount:N2} {context.Currency}" : "-")</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Success">@context.Status</MudChip></MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private readonly DocumentSearchRequest _request = new();
    private PaginatedList<DocumentSummaryDto>? _results;
    private List<Department> _departments = new();
    private List<DocumentType> _docTypes = new();

    protected override async Task OnInitializedAsync()
    {
        _departments = await DbContext.Departments.AsNoTracking().ToListAsync();
        _docTypes = await DbContext.DocumentTypes.AsNoTracking().ToListAsync();
        await ExecuteSearch();
    }

    private async Task ExecuteSearch()
    {
        _results = await WorkflowService.SearchDocumentsAsync(_request);
    }
}
