@page "/"
@attribute [Authorize]
@inject DocumentWorkflowService WorkflowService

<MudText Typo="Typo.h4" GutterBottom="true">Enterprise Archive Dashboard</MudText>

@if (_stats is null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">Archived Documents</MudText>
                <MudText Typo="Typo.h4">@_stats.TotalArchivedDocuments</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Warning">Awaiting Validation</MudText>
                <MudText Typo="Typo.h4">@_stats.AwaitingValidationCount</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Info">AI Processing Queue</MudText>
                <MudText Typo="Typo.h4">@_stats.ProcessingCount</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Error">Processing Failures</MudText>
                <MudText Typo="Typo.h4">@_stats.ProcessingFailedCount</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mb-3">Recent Document Uploads</MudText>
    <MudTable Items="@_stats.RecentUploads" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Archive ID</MudTh>
            <MudTh>File Name</MudTh>
            <MudTh>Department</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>AI Confidence</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.DocumentNumber</MudTd>
            <MudTd>@context.OriginalFileName</MudTd>
            <MudTd>@context.DepartmentNameFr</MudTd>
            <MudTd>@context.DocumentTypeNameFr</MudTd>
            <MudTd>@(context.AiConfidence.HasValue ? $"{context.AiConfidence:P0}" : "-")</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small">@context.Status</MudChip></MudTd>
            <MudTd>
                @if (context.Status == DocumentStatus.AwaitingValidation)
                {
                    <MudButton Href="@($"/validation/{context.Id}")" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning">Validate</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private DashboardStatsDto? _stats;

    protected override async Task OnInitializedAsync()
    {
        _stats = await WorkflowService.GetDashboardStatsAsync();
    }
}
