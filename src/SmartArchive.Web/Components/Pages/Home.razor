@page "/"
@rendermode InteractiveServer
@using SmartArchive.Application
@using SmartArchive.Domain
@using System.Globalization
@inject IDocumentRepository Repository
@inject IDocumentWorkflow Workflow
<PageTitle>Vue d’ensemble · Smart Archive</PageTitle>
<div class="page-heading"><div><div class="eyebrow">SEWS MAROC · GESTION DOCUMENTAIRE</div><h1>Vue d’ensemble</h1><p>Suivez le traitement de vos documents et les validations en attente.</p></div><a class="button primary" href="/depot">＋ Déposer des documents</a></div>
@if (_stats is null) { <p>Chargement des indicateurs…</p> } else {
<div class="stat-grid"><article class="stat-card"><span class="stat-icon navy">▤</span><span class="stat-label">Documents archivés</span><strong>@Get("Total")</strong><small>Documents approuvés</small></article><article class="stat-card"><span class="stat-icon amber">◷</span><span class="stat-label">À valider</span><strong>@Get("Pending")</strong><small>En attente d’une revue humaine</small></article><article class="stat-card"><span class="stat-icon green">↥</span><span class="stat-label">Déposés aujourd’hui</span><strong>@Get("Today")</strong><small>Nouveaux documents</small></article><article class="stat-card"><span class="stat-icon red">!</span><span class="stat-label">Rejetés</span><strong>@Get("Rejected")</strong><small>À corriger ou compléter</small></article></div>
<div class="content-grid"><section class="panel"><div class="panel-head"><div><h2>Documents récents</h2><p>Derniers éléments traités dans l’archive</p></div><a href="/archive">Voir l’archive →</a></div><div class="table-wrap"><table><thead><tr><th>Document</th><th>Département</th><th>Date de dépôt</th><th>État</th></tr></thead><tbody>@foreach (var doc in _recent) { <tr><td><span class="file-mark">PDF</span><span class="doc-title">@doc.Title</span><small>@doc.FileName</small></td><td>@doc.DepartmentName</td><td>@doc.UploadedAt.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("fr-FR"))</td><td><span class="status @StatusClass(doc.Status)">@StatusText(doc.Status)</span></td></tr> } @if (_recent.Count == 0) { <tr><td colspan="4" class="empty">Aucun document pour l’instant. Déposez un premier PDF pour démarrer.</td></tr> }</tbody></table></div></section><aside class="panel departments"><div class="panel-head"><div><h2>Flux par département</h2><p>Documents archivés</p></div></div>@foreach (var pair in DepartmentStats()) { <div class="dept-row"><span>@pair.Name</span><strong>@pair.Count</strong><div class="bar"><i style="width:@Bar(pair.Count)%"></i></div></div> }</aside></div>
<div class="notice"><strong>Règle de conformité</strong><span>Aucun document n’est archivé automatiquement. Une validation humaine est obligatoire avant l’entrée dans l’archive officielle.</span><a href="/validation">Ouvrir le centre de validation →</a></div>
}
@code {
 private object? _stats; private List<ArchiveDocument> _recent = []; private List<Department> _departments = [];
 protected override async Task OnInitializedAsync() { _stats = await Repository.StatisticsAsync(); _recent = (await Repository.ListAsync()).Take(8).ToList(); _departments = (await Repository.DepartmentsAsync()).ToList(); }
 private System.Text.Json.JsonElement Prop(string n) => System.Text.Json.JsonSerializer.SerializeToElement(_stats).GetProperty(n);
 private int Get(string n) => Prop(n).GetInt32();
 private List<(string Name,int Count)> DepartmentStats() { try { return Prop("ByDepartment").EnumerateArray().Select(x => (x.GetProperty("Name").GetString() ?? "", x.GetProperty("Count").GetInt32())).ToList(); } catch { return []; } }
 private int Bar(int n) => Math.Clamp(n * 13, 5, 100);
 private static string StatusText(DocumentStatus s) => s switch { DocumentStatus.Archived => "Archivé", DocumentStatus.PendingValidation => "À valider", DocumentStatus.Processing => "Analyse IA", DocumentStatus.ProcessingFailed => "Échec", DocumentStatus.Rejected => "Rejeté", _ => s.ToString() };
 private static string StatusClass(DocumentStatus s) => s switch { DocumentStatus.Archived => "success", DocumentStatus.PendingValidation => "warning", DocumentStatus.ProcessingFailed or DocumentStatus.Rejected => "danger", _ => "info" };
}
