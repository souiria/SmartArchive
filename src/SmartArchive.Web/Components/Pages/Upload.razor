@page "/upload"
@attribute [Authorize]
@inject DocumentWorkflowService WorkflowService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Upload & AI Classification</MudText>

<MudPaper Class="pa-6" Elevation="2">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept=".pdf" FilesChanged="OnFilesSelected" MaximumFileCount="25">
        <ActivatorContent>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                Select Scanned PDFs (Batch Upload)
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>

    @if (_uploading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }

    @if (_uploadedDocs.Count > 0)
    {
        <MudList T="string" Class="mt-4">
            @foreach (var doc in _uploadedDocs)
            {
                <MudListItem Icon="@Icons.Material.Filled.PictureAsPdf">
                    <strong>@doc.DocumentNumber</strong> — @doc.OriginalFileName (Queued for Azure AI Document Intelligence)
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    private bool _uploading;
    private readonly List<Document> _uploadedDocs = new();

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        _uploading = true;
        try
        {
            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                var doc = await WorkflowService.IngestPdfAsync(stream, file.Name, "application/pdf");
                _uploadedDocs.Add(doc);
                Snackbar.Add($"Uploaded {file.Name} -> {doc.DocumentNumber}", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }
}
