@page "/depot"
@rendermode InteractiveServer
@using SmartArchive.Application
@inject IDocumentWorkflow Workflow
<PageTitle>Dépôt de documents · Smart Archive</PageTitle>
<MudStack Class="sa-page-header"><MudText Typo="Typo.overline" Class="sa-eyebrow">INGESTION DOCUMENTAIRE</MudText><MudText Typo="Typo.h4" Class="sa-page-title">Déposer des documents</MudText><MudText Class="sa-page-subtitle">Importez un ou plusieurs PDF. Chaque suggestion IA sera vérifiée par un valideur avant archivage.</MudText></MudStack>
<MudPaper Outlined="true" Class="sa-surface pa-5 pa-md-7" Style="max-width:900px">
    <InputFile id="pdfInput" OnChange="UploadFiles" accept="application/pdf,.pdf" multiple class="sa-upload-input" />
    <label for="pdfInput" class="sa-upload-zone"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Color="Color.Primary" /><MudText Typo="Typo.subtitle1" Class="sa-upload-title">Glissez vos PDF ici ou cliquez pour parcourir</MudText><MudText Class="sa-upload-help">PDF uniquement · maximum 50 Mo par fichier · sélection multiple</MudText></label>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-5">Les doublons exacts sont détectés par empreinte SHA-256.</MudText>
    @if (_busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Class="mb-4" /><MudText Typo="Typo.body2">Import et analyse en cours…</MudText> }
    @if (!string.IsNullOrEmpty(_message)) { <MudAlert Severity="@(_error ? Severity.Error : Severity.Success)" Variant="Variant.Outlined" Class="my-4">@_message</MudAlert> }
    @if (_uploaded.Count > 0) { <MudDivider Class="my-5" /><MudText Typo="Typo.h6" Class="sa-panel-title mb-3">Résultat du dépôt</MudText><MudList T="string" Dense="true">@foreach(var f in _uploaded) { <MudListItem T="string" Icon="@Icons.Material.Filled.PictureAsPdf" IconColor="Color.Error"><MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100"><MudText Typo="Typo.body2">@f.FileName</MudText><MudChip T="string" Size="Size.Small" Color="@(f.Duplicate ? Color.Warning : Color.Info)" Variant="Variant.Outlined">@(f.Duplicate ? "Doublon détecté" : "En file de validation")</MudChip></MudStack></MudListItem> }</MudList><MudButton Href="/validation" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Class="mt-4">Accéder à la file de validation</MudButton> }
</MudPaper>
@code { private bool _busy, _error; private string _message=""; private List<SmartArchive.Domain.UploadResult> _uploaded=[]; private async Task UploadFiles(InputFileChangeEventArgs e) { _busy=true; _message=""; _uploaded=[]; _error=false; try { foreach(var file in e.GetMultipleFiles(20)) { await using var stream=file.OpenReadStream(50*1024*1024); _uploaded.Add(await Workflow.UploadAsync(file.Name,file.ContentType,stream,"Opérateur local")); } _message=$"{_uploaded.Count} fichier(s) traité(s). Tous les nouveaux documents attendent une validation humaine."; } catch(Exception ex) { _error=true; _message=ex.Message; } finally { _busy=false; } } }
