@page "/depot"
@rendermode InteractiveServer
@using SmartArchive.Application
@inject IDocumentWorkflow Workflow
<PageTitle>Dépôt de documents · Smart Archive</PageTitle>
<div class="page-heading"><div><div class="eyebrow">INGESTION DOCUMENTAIRE</div><h1>Déposer des documents</h1><p>Importez un ou plusieurs fichiers PDF. L’analyse propose des métadonnées à faire vérifier par une personne habilitée.</p></div></div>
<section class="upload-panel"><InputFile OnChange="UploadFiles" accept="application/pdf,.pdf" multiple id="pdfInput" /><label for="pdfInput" class="drop-zone"><span class="upload-icon">↑</span><strong>Glissez vos PDF ici ou cliquez pour parcourir</strong><span>PDF uniquement · 50 Mo maximum par fichier · multi-sélection prise en charge</span></label><p class="muted">Les fichiers identiques déjà déposés sont détectés par empreinte SHA-256.</p>@if (_busy) { <div class="progress-line"><i></i></div><p>Import et analyse en cours…</p> } @if (!string.IsNullOrEmpty(_message)) { <div class="alert @(_error ? "alert-error" : "alert-success")">@_message</div> } @if (_uploaded.Count > 0) { <h2>Résultat du dépôt</h2>@foreach(var f in _uploaded) { <div class="result-row"><span class="file-mark">PDF</span><span>@f.FileName</span><span class="status warning">@(f.Duplicate ? "Doublon détecté" : "En file de validation")</span></div> }<a class="button primary" href="/validation">Accéder à la file de validation →</a> }</section>
@code { private bool _busy, _error; private string _message=""; private List<SmartArchive.Domain.UploadResult> _uploaded=[]; private async Task UploadFiles(InputFileChangeEventArgs e) { _busy=true; _message=""; _uploaded=[]; _error=false; try { foreach(var file in e.GetMultipleFiles(20)) { await using var stream=file.OpenReadStream(50*1024*1024); _uploaded.Add(await Workflow.UploadAsync(file.Name,file.ContentType,stream,"Opérateur local")); } _message=$"{_uploaded.Count} fichier(s) traité(s). Tous les nouveaux documents attendent une validation humaine."; } catch(Exception ex) { _error=true; _message=ex.Message; } finally { _busy=false; } } }
