@page "/login"
@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">
    <MudPaper Elevation="4" Class="pa-8">
        <MudText Typo="Typo.h5" GutterBottom="true" Align="Align.Center">SmartArchive AI — Connexion</MudText>
        <form method="post" action="/account/login">
            <MudTextField T="string" Name="email" Label="Email" Variant="Variant.Outlined" Required="true" Class="mb-4" Value="@("admin@smartarchive.local")" />
            <MudTextField T="string" Name="password" Label="Mot de passe" InputType="InputType.Password" Variant="Variant.Outlined" Required="true" Class="mb-6" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
                Se connecter / تسجيل الدخول
            </MudButton>
        </form>
    </MudPaper>
</MudContainer>
