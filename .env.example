# Optional: SQL Server; otherwise the app uses local SQLite.
ConnectionStrings__SqlServer=

# Optional: Azure Blob Storage; when empty, PDFs are stored under App_Data.
AzureBlobStorage__ConnectionString=
AzureBlobStorage__Container=smartarchive

# Optional: Azure Document Intelligence endpoint.
# Set the resource API key in a secret store, or leave ApiKey blank and use DefaultAzureCredential.
AzureDocumentIntelligence__Endpoint=
AzureDocumentIntelligence__ApiKey=

# Optional workspace defaults. The Settings page can update these values at runtime.
SmartArchive__User__DisplayName=Abderrahim Souirite
SmartArchive__Storage__LocalFolder=documents
SmartArchive__Compression__Enabled=false
